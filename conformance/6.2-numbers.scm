;; R7RS-small 6.2: numbers, and 6.3: booleans.
;; Complex numbers are optional (6.2.3) and tulip has none: the report's
;; complex examples are kept as test-unsupported, read from strings so the
;; file itself can be read.
(import (scheme base) (scheme inexact) (scheme complex) (scheme read)
        (conformance test))

(define (num s) (read (open-input-string s)))
(define no-complex "complex numbers are optional (6.2.3); tulip implements the reals only")

(section "6.2.2 Exactness")
(test #t (exact? (+ 1/3 2/3)))
(test #t (inexact? (+ 1 0.5)))
(test 1/3 (/ 1 3))
(test #t (exact? (/ 3 4)))
(test #f (= (/ 3 4) 0))

(section "6.2.5 Syntax of numerical constants")
(test 255 (num "#xff"))
(test 255 (num "#XFF"))
(test 7 (num "#b111"))
(test 63 (num "#o77"))
(test 10 (num "#d10"))
(test #t (exact? (num "#e1.5")))
(test 3/2 (num "#e1.5"))
(test #t (inexact? (num "#i3/4")))
(test 0.75 (num "#i3/4"))
(test 10 (num "#e#x0a"))
(test 10.0 (num "#x#i0a"))
(test #t (inexact? (num "1.")))
(test #t (inexact? (num ".5")))
(test 100.0 (num "1e2"))
(test 100.0 (num "1E2"))
(test 0.001 (num "1e-3"))
(test #t (exact? (num "12")))
(test -12 (num "-12"))
(test 12 (num "+12"))
(test 1/2 (num "2/4"))
(test #t (let ((x (num "+inf.0"))) (and (real? x) (> x 1e308))))
(test #t (let ((x (num "-inf.0"))) (and (real? x) (< x -1e308))))
(test #t (nan? (num "+nan.0")))
(test #t (nan? (num "-nan.0")))
(test-unsupported no-complex (test #t (complex? (num "3+4i"))))
(test-unsupported no-complex (test 2 (real-part (num "2@0"))))

(section "6.2.6 Numerical type predicates")
(test #t (complex? 3))
(test #t (real? 3))
(test #t (real? #e1e10))
(test #t (real? +inf.0))
(test #t (real? +nan.0))
(test #f (rational? -inf.0))
(test #f (rational? +nan.0))
(test #t (rational? 3.5))
(test #t (rational? 6/10))
(test #t (rational? 6/3))
(test #t (integer? 3.0))
(test #t (integer? 8/4))
(test #f (integer? 3.5))
(test #f (integer? +inf.0))
(test #t (number? 1/2))
(test '(#f #f #f #f #f) (map (lambda (p) (p 'a)) (list number? complex? real? rational? integer?)))
(test '(#f #f) (list (number? "1") (integer? #\1)))
(test-unsupported no-complex (test #t (complex? (num "3+4i"))))
(test-unsupported no-complex (test #t (real? (num "-2.5+0i"))))
(test-unsupported no-complex (test #f (real? (num "-2.5+0.0i"))))
(test-unsupported no-complex (test #t (integer? (num "3+0i"))))
(test #f (exact? 3.0))
(test #t (exact? #e3.0))
(test #t (inexact? 3.))
(test #t (exact-integer? 32))
(test #f (exact-integer? 32.0))
(test #f (exact-integer? 32/5))
(test #t (finite? 3))
(test #f (finite? +inf.0))
(test #f (finite? +nan.0))
(test #f (infinite? 3))
(test #t (infinite? +inf.0))
(test #t (infinite? -inf.0))
(test #f (infinite? +nan.0))
(test #t (nan? +nan.0))
(test #f (nan? 32))
(test-unsupported no-complex (test #f (finite? (num "3.0+inf.0i"))))
(test-unsupported no-complex (test #t (infinite? (num "3.0+inf.0i"))))
(test-unsupported no-complex (test #t (nan? (num "+nan.0+5.0i"))))
(test-unsupported no-complex (test #f (nan? (num "1+2i"))))

(section "6.2.6 Comparison")
(test #t (= 1 1 1))
(test #f (= 1 1 2))
(test #t (= 1 1.0))
(test #t (= 1/2 0.5))
(test #t (< 1 2 3))
(test #f (< 1 3 2))
(test #t (> 3 2 1))
(test #t (<= 1 1 2))
(test #f (<= 2 1))
(test #t (>= 2 2 1))
(test #f (= +nan.0 +nan.0))
(test #f (< +nan.0 1))
(test #f (> +nan.0 1))
(test #t (= 0.0 -0.0))
(test #t (< -inf.0 -1e308 0 1e308 +inf.0))
;; exact comparison of large integers against inexact ones (transitivity)
(test #f (let ((big (expt 2 1000))) (= (- big 1) (+ big 1))))
(test #f (let ((big (expt 2 1000))) (and (= (- big 1) (inexact big)) (= (inexact big) (+ big 1)))))
(test #t (zero? 0))
(test #t (zero? 0.0))
(test #t (zero? -0.0))
(test #f (zero? 1))
(test #t (positive? 1))
(test #f (positive? 0))
(test #t (negative? -1/2))
(test #f (negative? 0.0))
(test #t (odd? 3))
(test #t (even? 0))
(test #t (even? -2))
(test #t (odd? 3.0))

(section "6.2.6 Arithmetic")
(test 4 (max 3 4))
(test 4.0 (max 3.9 4))
(test #t (inexact? (max 1 2.0)))
(test 3 (min 3 4))
(test 1.0 (min 1 2.0))
(test 7 (+ 3 4))
(test 3 (+ 3))
(test 0 (+))
(test 4 (* 4))
(test 1 (*))
(test -1 (- 3 4))
(test -6 (- 3 4 5))
(test -3 (- 3))
(test 3/20 (/ 3 4 5))
(test 1/3 (/ 3))
(test 2.5 (/ 5 2.0))
(test 2 (/ 4 2))
(test #t (exact? (/ 4 2)))
(test 7 (abs -7))
(test 7/2 (abs -7/2))
(test 7.5 (abs -7.5))
(test (expt 10 30) (* (expt 10 15) (expt 10 15)))
(test 0 (- (expt 2 100) (expt 2 100)))

(section "6.2.6 Integer division")
(test-values (2 1) (floor/ 5 2))
(test-values (-3 1) (floor/ -5 2))
(test-values (-3 -1) (floor/ 5 -2))
(test-values (2 -1) (floor/ -5 -2))
(test-values (2 1) (truncate/ 5 2))
(test-values (-2 -1) (truncate/ -5 2))
(test-values (-2 1) (truncate/ 5 -2))
(test-values (2 -1) (truncate/ -5 -2))
(test-values (2.0 -1.0) (truncate/ -5.0 -2))
(test -3 (floor-quotient -5 2))
(test 1 (floor-remainder -5 2))
(test -2 (truncate-quotient -5 2))
(test -1 (truncate-remainder -5 2))
(test -2 (quotient -5 2))
(test -1 (remainder -5 2))
(test 1 (modulo -5 2))
(test -1 (modulo 5 -2))
(test 1 (modulo 13 4))
(test 1 (remainder 13 4))
(test -1 (remainder -13 4))
(test 3 (modulo -13 4))
(test -1.0 (remainder -13 4.0))
(test #t (let loop ((cases '((17 5) (-17 5) (17 -5) (-17 -5) (7 7) (0 3))))
           (or (null? cases)
               (let ((n1 (caar cases)) (n2 (cadar cases)))
                 (and (= n1 (+ (* n2 (floor-quotient n1 n2)) (floor-remainder n1 n2)))
                      (= n1 (+ (* n2 (truncate-quotient n1 n2)) (truncate-remainder n1 n2)))
                      (loop (cdr cases)))))))
(test 4 (gcd 32 -36))
(test 0 (gcd))
(test 288 (lcm 32 -36))
(test 288.0 (lcm 32.0 -36))
(test 1 (lcm))
(test 3 (numerator (/ 6 4)))
(test 2 (denominator (/ 6 4)))
(test 2.0 (denominator (inexact (/ 6 4))))
(test 1 (denominator 0))
(test -3 (numerator -3/4))

(section "6.2.6 Rounding")
(test -5.0 (floor -4.3))
(test -4.0 (ceiling -4.3))
(test -4.0 (truncate -4.3))
(test -4.0 (round -4.3))
(test 3.0 (floor 3.5))
(test 4.0 (ceiling 3.5))
(test 3.0 (truncate 3.5))
(test 4.0 (round 3.5))
(test 2.0 (round 2.5))
(test -2.0 (round -2.5))
(test 4 (round 7/2))
(test 7 (round 7))
(test 2 (round 5/2))
(test -4 (floor -7/2))
(test #t (exact? (floor 7/2)))
(test 1/3 (rationalize (exact .3) 1/10))
(test #t (let ((r (rationalize .3 1/10))) (and (inexact? r) (= r (inexact 1/3)))))
(test 0 (rationalize 1/4 1/4))

(section "6.2.6 Transcendental functions")
(test-approx 1.0 (exp 0))
(test-approx 2.718281828459045 (exp 1))
(test-approx 0.0 (log 1))
(test-approx 1.0 (log (exp 1)))
(test-approx 3.0 (log 1000 10))
(test-approx 3.0 (log 8 2))
(test #t (let ((l (log 0.0))) (and (infinite? l) (negative? l))))
(test-approx 0.0 (sin 0))
(test-approx 1.0 (cos 0))
(test-approx 0.0 (tan 0))
(test-approx 1.5707963267948966 (asin 1))
(test-approx 0.0 (acos 1))
(test-approx 0.7853981633974483 (atan 1))
(test-approx 0.7853981633974483 (atan 1 1))
(test-approx 3.141592653589793 (atan 0 -1))
(test-approx -1.5707963267948966 (atan -1 0))
(test-approx 1.5707963267948966 (atan 1 0))
(test 0.0 (atan 0.0 1))
(test-unsupported no-complex (test-approx 1.5707963267948966 (imag-part (asin 2))))

(section "6.2.6 square, sqrt, exact-integer-sqrt, expt")
(test 1764 (square 42))
(test 4.0 (square 2.0))
(test 1/4 (square 1/2))
(test 3 (sqrt 9))
(test #t (exact? (sqrt 9)))
(test 2/3 (sqrt 4/9))
(test-approx 1.4142135623730951 (sqrt 2))
(test (expt 10 20) (sqrt (expt 10 40)))
(test-unsupported no-complex (test (num "+i") (sqrt -1)))
(test-values (2 0) (exact-integer-sqrt 4))
(test-values (2 1) (exact-integer-sqrt 5))
(test-values (4 1) (exact-integer-sqrt 17))
(test 1024 (expt 2 10))
(test 1/8 (expt 2 -3))
(test 1 (expt 0 0))
(test 0 (expt 0 5))
(test 1.0 (expt 0.0 0))
(test 0.0 (expt 0.0 5))
(test 8.0 (expt 2.0 3))
(test-approx 1.4142135623730951 (expt 2 1/2))
(test 1/27 (expt 1/3 3))

(section "6.2.6 Exactness conversion")
(test 0.5 (inexact 1/2))
(test #t (inexact? (inexact 1)))
(test 1/2 (exact 0.5))
(test 3 (exact 3.0))
(test #t (exact? (exact 3.0)))
(test 1.5 (exact->inexact 3/2))
(test 3/2 (inexact->exact 1.5))

(section "6.2.6 Complex library procedures on reals")
(test 3 (real-part 3))
(test 0 (imag-part 3))
(test 3 (magnitude -3))
(test 0 (angle 3))
(test-approx 3.141592653589793 (angle -1))
(test 2 (make-rectangular 2 0))
(test-unsupported no-complex (test 4 (magnitude (make-rectangular 3 4))))
(test-unsupported no-complex (test-approx 2.0 (real-part (make-polar 2 0.0001))))

(section "6.2.7 Numerical input and output")
(test "100" (number->string 100))
(test "-100" (number->string -100))
(test "1100100" (number->string 100 2))
(test "144" (number->string 100 8))
(test "64" (number->string 100 16))
(test "ff" (string-downcase (number->string 255 16)))
(test "1/3" (number->string 1/3))
(test "-1/3" (number->string -1/3))
(test #t (let ((s (number->string 1.5))) (eqv? 1.5 (string->number s))))
(test #t (let loop ((xs (list 0.1 1/3 1e21 1e-7 123.456 -0.0 (expt 2 70) (/ 22 7) (sqrt 2))))
           (or (null? xs)
               (and (eqv? (car xs) (string->number (number->string (car xs))))
                    (loop (cdr xs))))))
(test #t (let loop ((radix '(2 8 10 16)))
           (or (null? radix)
               (and (eqv? -12345 (string->number (number->string -12345 (car radix)) (car radix)))
                    (eqv? 7/16 (string->number (number->string 7/16 (car radix)) (car radix)))
                    (loop (cdr radix))))))
(test "0.1" (number->string 0.1))
(test #f (char=? #\# (string-ref (number->string 255 16) 0)))
(test 100 (string->number "100"))
(test 256 (string->number "100" 16))
(test 100.0 (string->number "1e2"))
(test 127 (string->number "#o177"))
(test 127 (string->number "#o177" 16))
(test #f (string->number "abc"))
(test #f (string->number ""))
(test #f (string->number "1/0x"))
(test #f (string->number "--1"))
(test #f (string->number "."))
(test 1/2 (string->number "1/2"))
(test 15 (string->number "f" 16))
(test #f (string->number "f"))

(section "6.3 Booleans")
(test #t #t)
(test #f #f)
(test #f '#f)
(test #f (not #t))
(test #f (not 3))
(test #f (not (list 3)))
(test #t (not #f))
(test #f (not '()))
(test #f (not (list)))
(test #f (not 'nil))
(test #t (boolean? #f))
(test #f (boolean? 0))
(test #f (boolean? '()))
(test #t (boolean=? #t #t))
(test #t (boolean=? #f #f #f))
(test #f (boolean=? #t #f))
(test #f (boolean=? #t #t #f))

(test-report)
