;; R7RS-small 6.8: vectors, and 6.9: bytevectors.
(import (scheme base) (scheme inexact) (conformance test))

(section "6.8 Vectors")
(test #(0 (2 2 2 2) "Anna") '#(0 (2 2 2 2) "Anna"))
(test #(0 (2 2 2 2) "Anna") #(0 (2 2 2 2) "Anna"))
(test #t (vector? #(1)))
(test #t (vector? #()))
(test #f (vector? '(1)))
(test #f (vector? "abc"))
(test #(x x) (make-vector 2 'x))
(test 3 (vector-length (make-vector 3)))
(test #() (make-vector 0))
(test #(a b c) (vector 'a 'b 'c))
(test #() (vector))
(test 0 (vector-length #()))
(test 3 (vector-length #(1 2 3)))
(test 8 (vector-ref '#(1 1 2 3 5 8 13 21) 5))
(test 13 (vector-ref '#(1 1 2 3 5 8 13 21) (exact (round (* 2 (acos -1))))))
(test #(0 ("Sue" "Sue") "Anna")
      (let ((vec (vector 0 '(2 2 2 2) "Anna")))
        (vector-set! vec 1 '("Sue" "Sue"))
        vec))
(test '(dah dah didah) (vector->list '#(dah dah didah)))
(test '(dah) (vector->list '#(dah dah didah) 1 2))
(test '(dah didah) (vector->list '#(dah dah didah) 1))
(test '() (vector->list #()))
(test #(dididit dah) (list->vector '(dididit dah)))
(test #() (list->vector '()))
(test "123" (vector->string #(#\1 #\2 #\3)))
(test "23" (vector->string #(#\1 #\2 #\3) 1))
(test "2" (vector->string #(#\1 #\2 #\3) 1 2))
(test #(#\A #\B #\C) (string->vector "ABC"))
(test #(#\B #\C) (string->vector "ABC" 1))
(test #(#\B) (string->vector "ABC" 1 2))
(define a #(1 8 2 8))
(define b (vector-copy a))
(vector-set! b 0 3)
(test #(3 8 2 8) b)
(test #(1 8 2 8) a)
(define c (vector-copy b 1 3))
(test #(8 2) c)
(test #(2 8) (vector-copy b 2))
(test #f (let ((v (vector 1))) (eq? v (vector-copy v))))
(test #t (let* ((x (list 1)) (v (vector x))) (eq? x (vector-ref (vector-copy v) 0))))
(define a2 (vector 1 2 3 4 5))
(define b2 (vector 10 20 30 40 50))
(vector-copy! b2 1 a2 0 2)
(test #(10 1 2 40 50) b2)
(test #(1 2 3) (let ((v (vector 0 0 0))) (vector-copy! v 0 #(1 2 3)) v))
(test #(1 1 2 3 5) (let ((v (vector 1 2 3 4 5))) (vector-copy! v 1 v 0 3) v))
(test #(2 3 4 4 5) (let ((v (vector 1 2 3 4 5))) (vector-copy! v 0 v 1 4) v))
(test #(a b c d e f) (vector-append #(a b c) #(d e f)))
(test #() (vector-append))
(test #(1 2 3) (vector-append #(1) #() #(2 3)))
(test #f (let ((v (vector 1))) (eq? v (vector-append v))))
(define a3 (vector 1 2 3 4 5))
(vector-fill! a3 'smash 2 4)
(test #(1 2 smash smash 5) a3)
(test #(z z) (let ((v (vector 1 2))) (vector-fill! v 'z) v))
(test #(1 z) (let ((v (vector 1 2))) (vector-fill! v 'z 1) v))

(section "6.9 Bytevectors")
(test #u8(0 10 5) '#u8(0 10 5))
(test #t (bytevector? #u8(0 10 5)))
(test #t (bytevector? #u8()))
(test #f (bytevector? #(0 10 5)))
(test #f (bytevector? "abc"))
(test #u8(12 12) (make-bytevector 2 12))
(test 3 (bytevector-length (make-bytevector 3)))
(test #u8(1 3 5 1 3 5) (bytevector 1 3 5 1 3 5))
(test #u8() (bytevector))
(test 3 (bytevector-length #u8(1 2 3)))
(test 0 (bytevector-length #u8()))
(test 8 (bytevector-u8-ref '#u8(1 1 2 3 5 8 13 21) 5))
(test 255 (bytevector-u8-ref #u8(255) 0))
(test #u8(1 3 3 4) (let ((bv (bytevector 1 2 3 4))) (bytevector-u8-set! bv 1 3) bv))
(define a4 #u8(1 2 3 4 5))
(test #u8(3 4) (bytevector-copy a4 2 4))
(test #u8(3 4 5) (bytevector-copy a4 2))
(test #u8(1 2 3 4 5) (bytevector-copy a4))
(test #f (let ((b (bytevector 1))) (eq? b (bytevector-copy b))))
(define a5 (bytevector 1 2 3 4 5))
(define b5 (bytevector 10 20 30 40 50))
(bytevector-copy! b5 1 a5 0 2)
(test #u8(10 1 2 40 50) b5)
(test #u8(1 1 2 3 5) (let ((v (bytevector 1 2 3 4 5))) (bytevector-copy! v 1 v 0 3) v))
(test #u8(2 3 4 4 5) (let ((v (bytevector 1 2 3 4 5))) (bytevector-copy! v 0 v 1 4) v))
(test #u8(0 1 2 3 4 5) (bytevector-append #u8(0 1 2) #u8(3 4 5)))
(test #u8() (bytevector-append))
(test "A" (utf8->string #u8(#x41)))
(test #u8(#xCE #xBB) (string->utf8 (string (integer->char #x3BB))))
(test "bc" (utf8->string #u8(97 98 99) 1))
(test "b" (utf8->string #u8(97 98 99) 1 2))
(test #u8(98 99) (string->utf8 "abc" 1))
(test #u8(98) (string->utf8 "abc" 1 2))
(test "" (utf8->string #u8()))
(test (string (integer->char #x1F600)) (utf8->string (string->utf8 (string (integer->char #x1F600)))))
(test 4 (bytevector-length (string->utf8 (string (integer->char #x1F600)))))

(test-report)
